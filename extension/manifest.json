{
  "manifest_version": 3,
  "name": "Konvo: DMs Only",
  "version": "0.1.6",
  "description": "Blocks instagram.com in your browser and sends you to Konvo for your DMs. Signing in still works.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.instagram.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cage",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
