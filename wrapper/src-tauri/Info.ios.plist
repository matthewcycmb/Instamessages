<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Tauri already sets PRODUCT_NAME to the productName at build time, so
	     CFBundleName resolves to Instachat. This is belt-and-braces: it pins
	     the home screen label even if the generated project changes. -->
	<key>CFBundleDisplayName</key>
	<string>Instachat</string>

	<!-- The app only speaks HTTPS to instagram.com and ships no custom
	     cryptography, which is exempt. Declaring it here stops every build
	     landing in TestFlight as "Missing Compliance", which would block
	     testers from installing until someone answered the prompt by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
